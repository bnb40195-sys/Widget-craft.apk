<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic Background Image -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_shape" />

    <!-- Foreground Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WidgetCraft"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#2538BDF8"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <!-- Main Value Area -->
        <TextView
            android:id="@+id/widget_main_value"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="12:00"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Subtitle / Notes / Quote / Date -->
        <TextView
            android:id="@+id/widget_sub_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ويدجت مميّز"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Actions / Counter row -->
        <LinearLayout
            android:id="@+id/widget_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/widget_btn_action"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+1 زيادة"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#4038BDF8"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
