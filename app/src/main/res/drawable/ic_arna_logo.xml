<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Outer Obsidian Circle -->
    <path android:pathData="M48,4 A44,44 0 1,1 47.99,4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="84"
                android:endY="84"
                android:startX="12"
                android:startY="12"
                android:type="linear">
                <item
                    android:color="#FF121B2E"
                    android:offset="0.0" />
                <item
                    android:color="#FF090D16"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Gradient Ring -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M48,7 A41,41 0 1,1 47.99,7 Z"
        android:strokeWidth="3.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="88"
                android:endY="82"
                android:startX="8"
                android:startY="14"
                android:type="linear">
                <item
                    android:color="#FF22D3EE"
                    android:offset="0.0" />
                <item
                    android:color="#FF3B82F6"
                    android:offset="0.5" />
                <item
                    android:color="#FFA855F7"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Subtle Orbit Arc -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M24,62 C30,72 64,74 74,56"
        android:strokeAlpha="0.45"
        android:strokeColor="#FF22D3EE"
        android:strokeLineCap="round"
        android:strokeWidth="2.5" />

    <!-- Stylized Geometric "A" Prism Emblem -->
    <path android:pathData="M48,20 L25,70 L35.5,70 L48,41.5 L60.5,70 L71,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="70"
                android:endY="72"
                android:startX="28"
                android:startY="20"
                android:type="linear">
                <item
                    android:color="#FF67E8F9"
                    android:offset="0.0" />
                <item
                    android:color="#FF22D3EE"
                    android:offset="0.45" />
                <item
                    android:color="#FFA855F7"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Crossbar / Orbit Spark -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M37,55 L59,55 L55.5,62 L40.5,62 Z" />
</vector>
